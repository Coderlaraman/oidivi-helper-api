APP_NAME="OiDiVi Helper"
APP_ENV=local
APP_KEY=base64:REEMPLAZA_APP_KEY
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REEMPLAZA_DB_DATABASE
DB_USERNAME=REEMPLAZA_DB_USERNAME
DB_PASSWORD=REEMPLAZA_DB_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- CONFIGURACIÓN DE REVERB ---
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=REEMPLAZA_REVERB_APP_ID
REVERB_APP_KEY=REEMPLAZA_REVERB_APP_KEY
REVERB_APP_SECRET=REEMPLAZA_REVERB_APP_SECRET
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- CONFIGURACIÓN PARA EL FRONTEND ---
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_DRIVER=file

# --- Correo (elige Mailtrap para test o Gmail para pruebas reales) ---
# Mailtrap
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=REEMPLAZA_MAILTRAP_USERNAME
# MAIL_PASSWORD=REEMPLAZA_MAILTRAP_PASSWORD
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="no-reply@oidivi-api.test"
# MAIL_FROM_NAME="${APP_NAME}"

# Gmail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REEMPLAZA_GMAIL_USERNAME
MAIL_PASSWORD=REEMPLAZA_GMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=REEMPLAZA_GMAIL_ADDRESS
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,oidivi-helper-web.test

# --- Stripe ---
STRIPE_KEY=REEMPLAZA_STRIPE_KEY
STRIPE_SECRET=REEMPLAZA_STRIPE_SECRET

# --- OAuth Google ---
GOOGLE_CLIENT_ID=REEMPLAZA_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REEMPLAZA_GOOGLE_CLIENT_SECRET
