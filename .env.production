# =============================================================
# OiDiVi Helper API – .env.production (Plantilla para Producción)
# Basado en .env.example, ajustado para despliegue con Docker + Nginx
# Rellena los valores REEMPLAZA_* y copia a .env en el servidor
# =============================================================

# --- Aplicación ---
APP_NAME="OiDiVi Helper"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.oidivi-helper.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Clave de encriptación (usa: php artisan key:generate --show)
APP_KEY=base64:REEMPLAZA_APP_KEY
APP_PREVIOUS_KEYS=

# --- Mantenimiento / CLI ---
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# --- Proxy (detrás de Nginx) ---
TRUSTED_PROXIES=*

# --- Base de datos (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=REEMPLAZA_DB_HOST
DB_PORT=3306
DB_DATABASE=REEMPLAZA_DB_DATABASE
DB_USERNAME=REEMPLAZA_DB_USERNAME
DB_PASSWORD=REEMPLAZA_DB_PASSWORD

# --- Sesión / Cache / Colas ---
CACHE_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=oidivi_helper

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.oidivi-helper.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# --- Broadcasting ---
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

# --- Archivos ---
FILESYSTEM_DISK=public

# --- Redis (opcional) ---
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- AWS S3 (opcional) ---
AWS_ACCESS_KEY_ID=REEMPLAZA_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REEMPLAZA_AWS_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=REEMPLAZA_BUCKET
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"

# --- Reverb (opcional) ---
REVERB_APP_ID=REEMPLAZA_REVERB_APP_ID
REVERB_APP_KEY=REEMPLAZA_REVERB_APP_KEY
REVERB_APP_SECRET=REEMPLAZA_REVERB_APP_SECRET
REVERB_HOST=api.oidivi-helper.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_SERVER_PATH=/app

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Correo (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=REEMPLAZA_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REEMPLAZA_SMTP_USERNAME
MAIL_PASSWORD=REEMPLAZA_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@oidivi-helper.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend / Sanctum ---
FRONTEND_URL=https://oidivi-helper.com
SANCTUM_STATEFUL_DOMAINS=oidivi-helper.com,www.oidivi-helper.com

# --- Stripe / Pagos ---
STRIPE_KEY=REEMPLAZA_STRIPE_KEY
STRIPE_SECRET=REEMPLAZA_STRIPE_SECRET

# --- OAuth (opcional) ---
GOOGLE_CLIENT_ID=REEMPLAZA_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REEMPLAZA_GOOGLE_CLIENT_SECRET
